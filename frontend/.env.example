# Local dev: leave empty — Vite proxy forwards /api/* to localhost:8000
VITE_API_URL=

# Production: set to your deployed backend URL
# VITE_API_URL=https://api.yourserver.com

# Telegram alerts (optional) — set these on the BACKEND environment, not here.
# 1. Create a bot: message @BotFather, send /newbot
# 2. TELEGRAM_BOT_TOKEN=<token BotFather gives you>
# 3. Message your bot once, then read chat.id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. TELEGRAM_CHAT_ID=<that id>
